# .env 로 복사 후 값 입력. .env 는 저장소 등록 금지

# ClawOps (실제 발신용)
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_FROM=070XXXXXXXX

# 세션 생성 요청의 X-App-Key 헤더 값
APP_KEY=dev-app-key

# 통화 백엔드: clawops(실제 발신) / sim(가상 ARS, 과금 없음)
CALL_BACKEND=clawops
# DTMF 전송: inband(톤을 통화 음성에 섞음) / sdk(ClawOps 미디어 채널 DTMF 이벤트)
DTMF_MODE=inband
# 음성 가상 ARS (sim 일 때): 1 이면 안내를 TTS 소리로 보내 STT·DTMF 톤까지 시험 (Windows). python app.py --sim-voice 와 같음
SIM_VOICE=0

# 음성 인식: whisper(로컬, 첫 실행 시 모델 다운로드) / openai(외부 STT, OPENAI_API_KEY 필요) / none
#   비교용 후보: rtzr / clova / gemini / qwen / omni (아래 "STT 후보 엔진" 설정, 코드는 stt_engines.py)
STT=whisper
# 기본: 한국어 저음질 음성으로 추가 학습한 Whisper small (MIT). 크기·속도는 small 과 같고 메뉴 이름 인식 정확도 향상
#   (stt_bench.py 합성 ARS 음성 기준 small 대비 문자 오류율 감소. 카드·계좌·결제·별표 오인식 감소)
# 그 밖에 small / medium / large-v3-turbo 또는 Hugging Face 의 CTranslate2 Whisper 모델 이름
# CPU 인식 속도: small 계열이 가장 빠르고 medium, large-v3-turbo 순으로 느려짐
WHISPER_MODEL=kimthegarden/whisper-small-ko-low-qual-voice-ct2
# 빔 크기. 1 이 가장 빠름
WHISPER_BEAM=1
# ARS 가 말하는 동안 단락 앞부분을 미리 인식 (1=사용). 단락 종료 뒤 인식 대기 시간 단축
STT_PREFETCH=1
# 미리 인식으로 넘길 최소 조각 길이(초). 짧으면 낱말이 조각 경계에 걸려 오인식(분실→분쇄, 문의→무늬) 증가
# 기본 5초: 더 짧거나 긴 조각보다 오인식이 적은 값. 단락 종료 뒤 추가 지연도 작음
STT_PREFETCH_MIN_S=5
# 말소리 없는 구간(무음·회선 잡음·숨소리·DTMF 잔향)을 잘라내고 인식 (1=사용, Silero VAD). 끄면 잡음에서 문장을 지어낼 수 있음
STT_VAD=1
# STT=openai 일 때 모델 (pip install openai 필요). 외부 STT 이므로 민감정보 되읽기 구간은 인식 제외
OPENAI_STT_MODEL=gpt-4o-transcribe
# NVIDIA GPU 사용 시 cuda (STT=qwen 도 이 값 사용)
WHISPER_DEVICE=cpu

# --- STT 후보 엔진 (STT 값으로 선택. 외부 엔진에는 민감정보 재확인 구간 전송 안 함) ---
# 단락 하나의 인식 제한 시간(초). 넘으면 그 단락은 빈 결과 (외부 엔진 rtzr·clova·gemini·openai 공통)
STT_TIMEOUT_S=10
# STT=rtzr: 리턴제로 개발자 콘솔의 client_id / client_secret. 8kHz 통화 음성을 그대로 전송
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
RTZR_MODEL=sommers_ko
RTZR_DOMAIN=CALL
# 키워드 부스팅 (sommers_ko 만). 한글·공백 20자 이하, 최대 100개, '단어:가중치(-5~5)'. 비교 실험 기준값은 빈 값
RTZR_KEYWORDS=
# STT=clova: CLOVA Speech 빌더 > 설정 > 연동 정보의 Invoke URL 과 Secret Key
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
# 8000(통화 원본) / 16000(업샘플링)
CLOVA_SAMPLE_RATE=8000
# 부스팅 단어 (쉼표 구분)와 가중치(1~5). 비교 실험 기준값은 빈 값
CLOVA_BOOSTINGS=
CLOVA_BOOST_WEIGHT=2
# STT=gemini: GEMINI_API_KEY 공용. 모델이 비면 GEMINI_MODEL 사용
GEMINI_STT_MODEL=
# MINIMAL / LOW. thinkingLevel 을 받지 않는 모델(2.5 계열)은 빈 값
GEMINI_STT_THINKING=MINIMAL
# STT=qwen: 로컬 Qwen3-ASR (GPU 권장, 저사양 CPU 는 실시간 처리 불가). 패키지 별도 설치
#   원본 형식(기본):  pip install qwen-asr torch
#   -hf 형식:        pip install "transformers>=5.13" torch   (LoRA 어댑터 사용 시 peft 추가)
#   qwen-asr 의 transformers 4.57 고정으로 두 방식은 가상환경 분리 필요. 패키지가 없으면 서버 시작 시 오류 표시
QWEN_ASR_MODEL=TeamUNIVA/qwen3_asr_1.7b_ko
# 예: QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B-hf, QWEN_ASR_ADAPTER=Playedwell03/qwen3-asr-1.7b-119ko-v5
QWEN_ASR_ADAPTER=
# hf / qwen-asr. 비우면 어댑터가 있거나 모델 이름이 -hf 로 끝나면 hf
QWEN_ASR_BACKEND=
# 어휘 힌트(시스템 프롬프트). 119 LoRA 는 힌트 사용 시 정확도 저하로 빈 값
QWEN_ASR_CONTEXT=
# 인식 언어. Korean(모델 카드 평가 조건) / 비우면 자동 판별 (말소리가 없으면 빈 결과. 무음 환각 비교용)
QWEN_ASR_LANGUAGE=Korean
# STT=omni: 음성을 직접 듣는 LLM(Qwen3-Omni 등)을 llama.cpp llama-server(OpenAI 호환)로 호출해 받아쓰기와 분류를 한 번에 수신
#   해석기도 같은 서버 사용 시(INTERPRETER=local_llm:LocalLlmInterpreter, LOCAL_LLM_API=openai, LOCAL_LLM_BASE_URL=OMNI_URL)
#   STT·해석을 모델 하나로 처리. 미리 인식 없음. 주소가 로컬(127.0.0.1·localhost·::1)이 아니면 외부 STT 로 간주해 되읽기 구간 전송 안 함
OMNI_URL=http://127.0.0.1:8080/v1
OMNI_MODEL=qwen3-omni
# Whisper 계열 후보는 코드 변경 없이 WHISPER_MODEL 로 시험 가능
#   WHISPER_MODEL=large-v3-turbo
#   batiai/batisay-ko-turbo (BatiAI Community 라이선스: 개인·연구·비영리 무료, 상업 이용은 협의): CTranslate2 로 변환 후 사용
#     pip install transformers torch   (변환에만 필요)
#     ct2-transformers-converter --model batiai/batisay-ko-turbo --output_dir batisay-ct2 \
#       --copy_files tokenizer.json preprocessor_config.json --quantization float16   후 WHISPER_MODEL=batisay-ct2
#     변환 폴더에 tokenizer.json 이 없으면 faster-whisper 가 whisper-tiny 의 토크나이저로 대체.
#     large-v3 계열과 특수 토큰 번호가 달라 인식 깨짐. 모델 저장소에 tokenizer.json 이 없어 --copy_files 에서
#     오류 발생 시 --copy_files 에서 tokenizer.json 을 빼고 변환한 뒤
#     python -c "from transformers import WhisperTokenizerFast as T; T.from_pretrained('batiai/batisay-ko-turbo').save_pretrained('batisay-ct2')"
#     로 생성해 추가
# 발화 판정 음량. 회선 잡음으로 안내가 끊기지 않으면 상향, 안내를 놓치면 하향
VAD_RMS=500

# AI 해석기(슬롯필링). 기본값은 목 데이터(mock_ai.json)
#   다른 구현체로 교체 시 모듈명:클래스명 지정
INTERPRETER=interpreter:MockInterpreter

# Gemini 해석기 (INTERPRETER=gemini_interpreter:GeminiInterpreter 일 때 사용)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 급하지 않은 호출(목적·결과 요약 등) 제한 시간(초). 실패 시 1회 재시도
GEMINI_TIMEOUT_S=6
# 생각 수준: MINIMAL(기본, 빠름) / LOW
GEMINI_THINKING=MINIMAL
# 번호를 눌러야 하는 판단(분류·점수·확인 질문)의 최대 대기 시간(초). 넘으면 재시도 없이 규칙·재질문. ARS 입력 대기 시간보다 짧게 설정
GEMINI_DECIDE_TIMEOUT_S=4

# 로컬 LLM 해석기 (INTERPRETER=local_llm:LocalLlmInterpreter 일 때 사용, 코드는 local_llm.py)
#   로컬에서 실행하는 LLM 서버 호출. 프롬프트·판단 규칙은 Gemini 해석기와 동일
#   모델 이름은 LLM 서버에 올라가 있는 이름 (Ollama: ollama list 로 확인)
LOCAL_LLM_MODEL=
# ollama: Ollama 고유 API (기본) / openai: OpenAI 호환 API (llama.cpp server, vLLM)
LOCAL_LLM_API=ollama
# 비우면 ollama 는 http://127.0.0.1:11434. openai 방식은 필수 (예 http://127.0.0.1:8080/v1. app.py 기본 포트 8000·QWEN_ASR_URL 기본 포트 8001 과 충돌 주의)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_TIMEOUT_S=6
# 번호를 눌러야 하는 판단의 최대 대기 시간(초). 비우면 GEMINI_DECIDE_TIMEOUT_S
LOCAL_LLM_DECIDE_TIMEOUT_S=4
# 생각(추론) 모드: 0=끔(기본, 빠름) / 1=켬 / low·medium·high / 빈 값=모델 기본. 그 밖의 값은 서버 시작 시 오류
LOCAL_LLM_THINK=0
# ollama 방식 문맥 길이(토큰). 지시문(약 1,500토큰)+안내가 들어갈 길이 필요. 짧으면 지시문 앞부분 잘림
LOCAL_LLM_NUM_CTX=8192
# ollama 방식 모델 상주 시간. 서버 시작 때 모델을 미리 올려 두고 이 시간 동안 유지 (24h 같은 기간, 숫자는 초, -1 은 계속 상주)
LOCAL_LLM_KEEP_ALIVE=24h
# JSON 을 공백·줄바꿈 없이 한 줄로 쓰라고 지시 (1=켬, 기본). 출력 토큰 감소로 판단 시간 단축
LOCAL_LLM_COMPACT=1
# grammar: LLM 서버가 스키마로 출력을 제한 (기본, 형식 보장) / prompt: 스키마를 지시문에 글로만 넣음 (더 빠름, 형식 오류는 규칙·재질문으로 대체)
#   prompt 는 생각 끔을 지키지 않는 qwen3 계열 모델에 사용 금지 (스키마 제한이 없으면 추론 문장이 길어져 시간 초과)
LOCAL_LLM_SCHEMA=grammar
# 분류 호출에서 받아쓰기 오류(발음이 비슷한 다른 말로 적힌 곳) 교정도 함께 수신 (1=켬, 기본 끔. Gemini·로컬 해석기 공통)
#   고친 문장은 자막·결과 요약·선택지 이름에만 사용, 판단·통화 기록에는 원문 사용. 숫자·번호가 바뀌는 교정은 폐기
LLM_FIX_TRANSCRIPT=0

# 통화 기록 (세션 생성 시 record=true, 웹 화면의 '통화 기록 남기기')
# 통화 종료 시 서버 디스크에도 저장 (1=저장, 기본). 폴더: RECORDING_DIR/<목적>_<전화번호>_<기관>_<날짜-시각>/ (call.wav, log.json, log.txt)
#   recordings/ 는 git 등록 제외. 되읽기 소리·인식 문장이 들어 있으므로 시험 종료 후 삭제
RECORDING_SAVE=1
# 저장 위치. 비우면 서버 폴더의 recordings/
RECORDING_DIR=
# 1 이면 앱의 기록 요청이 없어도(Android 앱 등) 모든 통화 기록. 시험 기간에만 사용
RECORD_ALWAYS=0

# 발신 뒤 이 시간(초) 안에 상대가 받지 않으면 끊고 no_answer 로 종료 (울림 뒤 통신망이 아무 신호를 주지 않는 경우 대비). 0 이면 끔
DIAL_TIMEOUT_S=60
