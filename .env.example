# .env 로 복사 후 값 입력. .env 는 커밋 금지

# ClawOps (실통화용)
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_FROM=070XXXXXXXX

# 세션 생성 요청의 X-App-Key 헤더 값
APP_KEY=dev-app-key

# 통화 백엔드: clawops(실제 발신) / sim(가상 ARS, 과금 없음)
CALL_BACKEND=clawops
# DTMF 전송: inband(톤을 통화 음성에 섞음, 실통화 확인됨) / sdk(ClawOps 미디어 채널 DTMF 이벤트)
DTMF_MODE=inband
# 음성 가상 ARS (sim 일 때): 1 이면 안내를 TTS 소리로 보내 STT·DTMF 톤까지 시험 (Windows). python app.py --sim-voice 와 같음
SIM_VOICE=0

# 음성 인식: whisper(로컬, 첫 실행 시 모델 다운로드) / openai(외부 STT, OPENAI_API_KEY 필요) / none
#   비교용 후보: rtzr / clova / gemini / qwen (아래 "STT 후보 엔진" 설정, 코드는 stt_engines.py)
STT=whisper
# 기본: 한국어 저음질 음성으로 추가 학습한 Whisper small (MIT). 크기·속도는 small 과 같고 메뉴 이름 인식이 더 정확
#   (stt_bench.py 합성 ARS 음성 기준 문자 오류율 small 10.6% → 9.4%. 카드·계좌·결제·별표 오인식 감소)
# 그 밖에 small / medium / large-v3-turbo 또는 Hugging Face 의 CTranslate2 Whisper 모델 이름
# CPU 단락당 인식 시간: small 계열 1.3~2초, medium 3.5~4.5초, large-v3-turbo 4.5초 이상
WHISPER_MODEL=kimthegarden/whisper-small-ko-low-qual-voice-ct2
# 빔 크기. 1 이 가장 빠름
WHISPER_BEAM=1
# ARS 가 말하는 동안 단락 앞부분을 미리 인식 (1=사용). 단락이 끝난 뒤 인식 시간 small 기준 약 2초 → 0.6초
STT_PREFETCH=1
# STT=openai 일 때 모델. 외부 STT 이므로 민감정보를 다시 읽어 주는 구간은 인식하지 않는다
OPENAI_STT_MODEL=gpt-4o-transcribe
# NVIDIA GPU 사용 시 cuda (STT=qwen 도 이 값을 쓴다)
WHISPER_DEVICE=cpu

# --- STT 후보 엔진 (STT 값으로 선택. 외부 엔진은 민감정보 재확인 구간을 보내지 않는다) ---
# 단락 하나의 인식 제한 시간(초). 넘으면 그 단락은 빈 결과
STT_TIMEOUT_S=10
# STT=rtzr: 리턴제로 개발자 콘솔의 client_id / client_secret. 8kHz 통화 음성을 그대로 전송
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
RTZR_MODEL=sommers_ko
RTZR_DOMAIN=CALL
# 키워드 부스팅 (sommers_ko 만). 한글·공백 20자 이하, 최대 100개, '단어:가중치(-5~5)'. 비교 실험 기준값은 비워 둔다
RTZR_KEYWORDS=
# STT=clova: CLOVA Speech 빌더 > 설정 > 연동 정보의 Invoke URL 과 Secret Key
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=
# 8000(통화 원본) / 16000(업샘플링)
CLOVA_SAMPLE_RATE=8000
# 부스팅 단어 (쉼표 구분)와 가중치(1~5). 비교 실험 기준값은 비워 둔다
CLOVA_BOOSTINGS=
CLOVA_BOOST_WEIGHT=2
# STT=gemini: GEMINI_API_KEY 를 함께 쓴다. 모델이 비면 GEMINI_MODEL
GEMINI_STT_MODEL=
# MINIMAL / LOW. thinkingLevel 을 받지 않는 모델(2.5 계열)은 비워 둔다
GEMINI_STT_THINKING=MINIMAL
# STT=qwen: 로컬 Qwen3-ASR (GPU 권장, 라즈베리파이 CPU 는 실시간 불가). 패키지 별도 설치
#   원본 형식(기본):  pip install qwen-asr torch
#   -hf 형식 + LoRA: pip install "transformers>=5.13" peft torch   (qwen-asr 와 transformers 버전이 충돌하므로 가상환경 분리)
QWEN_ASR_MODEL=TeamUNIVA/qwen3_asr_1.7b_ko
# 예: QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B-hf, QWEN_ASR_ADAPTER=Playedwell03/qwen3-asr-1.7b-119ko-v5
QWEN_ASR_ADAPTER=
# hf / qwen-asr. 비우면 어댑터가 있거나 모델 이름이 -hf 로 끝나면 hf
QWEN_ASR_BACKEND=
# 어휘 힌트(시스템 프롬프트). 119 LoRA 는 힌트를 주면 정확도가 떨어지므로 비워 둔다
QWEN_ASR_CONTEXT=
# Whisper 계열 후보는 코드 변경 없이 WHISPER_MODEL 로 시험한다
#   WHISPER_MODEL=large-v3-turbo
#   batiai/batisay-ko-turbo: ct2-transformers-converter --model batiai/batisay-ko-turbo --output_dir batisay-ct2 \
#       --copy_files tokenizer.json preprocessor_config.json --quantization float16   후 WHISPER_MODEL=batisay-ct2
# 발화 판정 음량. 회선 잡음으로 안내가 끊기지 않으면 상향, 안내를 놓치면 하향
VAD_RMS=500

# AI 슬롯필링(팀원 담당). 기본값은 목 데이터(mock_ai.json)
#   팀원 구현체로 교체 시 모듈명:클래스명 지정
INTERPRETER=interpreter:MockInterpreter

# Gemini 해석기 (INTERPRETER=gemini_interpreter:GeminiInterpreter 일 때 사용)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 급하지 않은 호출(목적·결과 요약 등) 제한 시간(초). 실패 시 1회 재시도
GEMINI_TIMEOUT_S=6
# 생각 수준: MINIMAL(기본, 빠름) / LOW (건강보험 평가 정답률 같음)
GEMINI_THINKING=MINIMAL
# 번호를 눌러야 하는 판단(분류·점수·확인 질문)의 최대 대기 시간(초). 넘으면 재시도 없이 규칙·재질문. ARS 입력 대기(KB 4.5초)보다 짧게
GEMINI_DECIDE_TIMEOUT_S=4
