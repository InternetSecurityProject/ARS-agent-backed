# .env 로 복사 후 값 입력. .env 는 커밋 금지

# ClawOps (실통화용)
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_FROM=070XXXXXXXX

# 세션 생성 요청의 X-App-Key 헤더 값
APP_KEY=dev-app-key

# 통화 백엔드: clawops(실제 발신) / sim(가상 ARS, 과금 없음)
CALL_BACKEND=clawops

# 음성 인식: whisper(로컬, 첫 실행 시 모델 다운로드) / none
STT=whisper
# tiny / base / small / medium. CPU 는 small 권장, 느린 경우 base
WHISPER_MODEL=small
# NVIDIA GPU 사용 시 cuda
WHISPER_DEVICE=cpu
# 발화 판정 음량. 회선 잡음으로 안내가 끊기지 않으면 상향, 안내를 놓치면 하향
VAD_RMS=500

# AI 슬롯필링(팀원 담당). 기본값은 목 데이터(mock_ai.json)
#   팀원 구현체로 교체 시 모듈명:클래스명 지정
INTERPRETER=interpreter:MockInterpreter

# Gemini 해석기 (INTERPRETER=gemini_interpreter:GeminiInterpreter 일 때 사용)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 한 번 호출 제한 시간(초). 실패·초과 시 1회 재시도 후 번호를 누르지 않고 사용자에게 묻는다
GEMINI_TIMEOUT_S=6
# 생각 수준: LOW(기본, AI 검증 기준) / MINIMAL(조금 빠름)
GEMINI_THINKING=LOW
