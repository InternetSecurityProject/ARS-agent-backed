# .env로 복사한 뒤 본인 키를 입력한다. 실제 키는 커밋하지 않는다.
# 기본은 가상 ARS. Jev는 가상 ARS에서도 유료 API를 호출할 수 있다.
CALL_BACKEND=sim
APP_KEY=
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
CLAWOPS_FROM=
DTMF_MODE=inband
SIM_VOICE=0

STT=openai
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-transcribe
STT_PREFETCH=1
STT_TIMEOUT_S=10
VAD_RMS=500
MIN_VOICED_S=0.4

INTERPRETER=jev_phrase_interpreter:PhraseJevInterpreter
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_S=3
MAX_REVISIT=3
MAX_PRESSES=10

# 아래 경로는 docs/OpenAI-STT-Jev-local.md의 실행 코드에서 읽는다.
# app.py가 이 환경변수를 직접 Settings에 적용하는 것은 아니다.
PRIVATE_STT_MODEL=
