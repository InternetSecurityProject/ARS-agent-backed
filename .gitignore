# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Windows 전용 실행 스크립트 (각자 PC 에만 둔다)
*.bat

# 로그·임시 (api_check.py --audio 의 WAV 포함)
*.log
*.wav
_to_delete/

# 음성 가상 ARS 합성 음성 캐시
.sim_audio/

# STT 비교용 시험 음성 (합성 음성, 개인정보 없음)은 저장소에 둔다
!bench_clips/*.wav

# 비교용 가상환경·측정 출력 (각자 PC 에만 둔다)
