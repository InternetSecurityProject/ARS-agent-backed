bench_real/

# bench 시나리오 녹음·단락·평가 결과 (저장 위치 결정 전까지 저장소에 넣지 않는다)
bench/raw/
bench/data/
bench/out/

# 웹 화면 빌드용 외부 패키지 (web/build.py 준비 단계에서 받는다)
web/vendor/

# 로컬 실험 환경·모델·실통화 내보내기 (공유하지 않는다)
